# FiscolItA · bot de Telegram
# Copiar a .env (cp .env.example .env) y completar. .env NUNCA se sube a GitHub.

# 1) Token que entrega @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=

# 2) IDs de Telegram autorizados, separados por coma (escríbele /id al bot para ver el tuyo)
TELEGRAM_ALLOWED_USERS=

# 3) Motor de IA (elige uno):
#    Suscripción:  claude (Claude Pro/Max + Claude Code) · codex (ChatGPT Plus/Pro + Codex CLI)
#    CLI:          gemini-cli (Gemini CLI + GEMINI_API_KEY)
#    API:          anthropic · openai · gemini · openrouter
#    Local:        ollama · lmstudio · llamacpp · jan · localai · vllm · gpt4all · koboldcpp · local (con FISCOLITA_BASE_URL)
FISCOLITA_BACKEND=claude

# 4) Modelo: obligatorio en openai, gemini, openrouter, ollama, jan, localai, vllm y gpt4all; opcional en el resto
#    (con anthropic el defecto es claude-opus-5-5; usa el nombre exacto que indique tu proveedor)
FISCOLITA_MODEL=

# 5) Clave de la API que uses (solo una)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Opcional
# FISCOLITA_EFFORT=medium          # anthropic: low | medium | high
# FISCOLITA_BASE_URL=              # otro servidor compatible con OpenAI (ej. Ollama remoto)
# FISCOLITA_HORA_AVISOS=08:30      # hora de las alertas diarias (Chile)
# GROQ_API_KEY=                    # transcripción de notas de voz (o OPENAI_API_KEY, o whisper local)
# FISCOLITA_MAX_MENSAJES=60        # largo máximo de una conversación antes de reiniciarla
# FISCOLITA_SIN_ACTUALIZAR=1       # desactiva la revisión diaria de novedades del SII
# CLAUDE_BIN=claude · CODEX_BIN=codex · GEMINI_BIN=gemini   # rutas a los CLIs
